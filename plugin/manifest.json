{
  "manifest_version": 2,
  "name": "Agent Reader Bridge",
  "version": "0.1.3",
  "description": "Share the current PDF, physical page and live selection with local MCP agents.",
  "applications": {
    "zotero": {
      "id": "agent-reader-bridge@local.workspace",
